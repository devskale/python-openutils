# UniInfer architecture — render:  d2 docs/architecture.d2 docs/architecture.svg
# Compact vertical layout; one-line labels (detail lives in ARCHITECTURE.md).
# A = Catalog.resolve_for_instance (overrides → access filter).
# B = provider list_models template method (_model_info dialect seam).

direction: down
sketch: false

client: Client { shape: person; style.fill: "#e0e7ff" }

proxy_app: "proxy_app.py — FastAPI entry" { style.fill: "#dbeafe" }

routers: "proxy_routers" {
  style.fill: "#f1f5f9"
  models: "models.py\n/v1/models · /v1/catalog"
  chat: "chat.py\n/v1/chat/completions"
  media: "media.py\nimages · TTS · STT"
}

services: "proxy_services" {
  style.fill: "#fef3c7"
  catalog: "Catalog\nresolve_for_instance (A)\noverrides → access filter"
  streaming: "streaming.py\nSSE · reasoning_content"
}

config: "config" {
  style.fill: "#fce7f3"
  instances: "instances.py\nfleet overlay · access"
  providers_cfg: "providers.py\nPROVIDER_CONFIGS"
}

providers: "providers" {
  style.fill: "#dcfce7"
  base: "OpenAICompatibleChatProvider\nlist_models() template method" { style.fill: "#86efac" }
  dialect: "providers (_model_info)\naccess · cost · caps"
  custom: "SDK / custom list_models\ngroq · ollama · tu · cloudflare · …"
}

backends: Backends { shape: cylinder; style.fill: "#e2e8f0" }

client -> proxy_app
proxy_app -> routers
routers.models -> services.catalog: "/v1/models/:alias"
routers.chat -> providers: "provider@model"
services.catalog -> config.instances: "resolve_instance"
services.catalog -> providers.base: "list_models"
providers.base -> providers.dialect: "_model_info (B)" { style.stroke: "#16a34a"; style.bold: true }
providers -> backends: "complete / GET /models"
